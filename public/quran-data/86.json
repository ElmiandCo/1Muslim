[{"verse_key":"86:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ"},{"verse_key":"86:2","arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"},{"verse_key":"86:3","arabic":"ٱلنَّجْمُ ٱلثَّاقِبُ"},{"verse_key":"86:4","arabic":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"},{"verse_key":"86:5","arabic":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ"},{"verse_key":"86:6","arabic":"خُلِقَ مِن مَّآءٍ دَافِقٍ"},{"verse_key":"86:7","arabic":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"},{"verse_key":"86:8","arabic":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ"},{"verse_key":"86:9","arabic":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"},{"verse_key":"86:10","arabic":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ"},{"verse_key":"86:11","arabic":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"},{"verse_key":"86:12","arabic":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"},{"verse_key":"86:13","arabic":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ"},{"verse_key":"86:14","arabic":"وَمَا هُوَ بِٱلْهَزْلِ"},{"verse_key":"86:15","arabic":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"},{"verse_key":"86:16","arabic":"وَأَكِيدُ كَيْدًا"},{"verse_key":"86:17","arabic":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"}]
