[{"verse_key":"87:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى"},{"verse_key":"87:2","arabic":"ٱلَّذِى خَلَقَ فَسَوَّىٰ"},{"verse_key":"87:3","arabic":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ"},{"verse_key":"87:4","arabic":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ"},{"verse_key":"87:5","arabic":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ"},{"verse_key":"87:6","arabic":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ"},{"verse_key":"87:7","arabic":"إِلَّا مَا شَآءَ ٱللَّهُ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ"},{"verse_key":"87:8","arabic":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ"},{"verse_key":"87:9","arabic":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ"},{"verse_key":"87:10","arabic":"سَيَذَّكَّرُ مَن يَخْشَىٰ"},{"verse_key":"87:11","arabic":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى"},{"verse_key":"87:12","arabic":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ"},{"verse_key":"87:13","arabic":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"verse_key":"87:14","arabic":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ"},{"verse_key":"87:15","arabic":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ"},{"verse_key":"87:16","arabic":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"},{"verse_key":"87:17","arabic":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ"},{"verse_key":"87:18","arabic":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ"},{"verse_key":"87:19","arabic":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ"}]
