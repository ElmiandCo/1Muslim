[{"verse_key":"75:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ"},{"verse_key":"75:2","arabic":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ"},{"verse_key":"75:3","arabic":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"},{"verse_key":"75:4","arabic":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ"},{"verse_key":"75:5","arabic":"بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ"},{"verse_key":"75:6","arabic":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ"},{"verse_key":"75:7","arabic":"فَإِذَا بَرِقَ ٱلْبَصَرُ"},{"verse_key":"75:8","arabic":"وَخَسَفَ ٱلْقَمَرُ"},{"verse_key":"75:9","arabic":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ"},{"verse_key":"75:10","arabic":"يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ"},{"verse_key":"75:11","arabic":"كَلَّا لَا وَزَرَ"},{"verse_key":"75:12","arabic":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ"},{"verse_key":"75:13","arabic":"يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ"},{"verse_key":"75:14","arabic":"بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ"},{"verse_key":"75:15","arabic":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"},{"verse_key":"75:16","arabic":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"},{"verse_key":"75:17","arabic":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ"},{"verse_key":"75:18","arabic":"فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ"},{"verse_key":"75:19","arabic":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ"},{"verse_key":"75:20","arabic":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ"},{"verse_key":"75:21","arabic":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ"},{"verse_key":"75:22","arabic":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ"},{"verse_key":"75:23","arabic":"إِلَىٰ رَبِّهَا نَاظِرَةٌ"},{"verse_key":"75:24","arabic":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ"},{"verse_key":"75:25","arabic":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ"},{"verse_key":"75:26","arabic":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ"},{"verse_key":"75:27","arabic":"وَقِيلَ مَنْ رَاقٍ"},{"verse_key":"75:28","arabic":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ"},{"verse_key":"75:29","arabic":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"},{"verse_key":"75:30","arabic":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ"},{"verse_key":"75:31","arabic":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"},{"verse_key":"75:32","arabic":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ"},{"verse_key":"75:33","arabic":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ"},{"verse_key":"75:34","arabic":"أَوْلَىٰ لَكَ فَأَوْلَىٰ"},{"verse_key":"75:35","arabic":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"},{"verse_key":"75:36","arabic":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى"},{"verse_key":"75:37","arabic":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ"},{"verse_key":"75:38","arabic":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ"},{"verse_key":"75:39","arabic":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"},{"verse_key":"75:40","arabic":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ"}]
