[{"verse_key":"107:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"},{"verse_key":"107:2","arabic":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"},{"verse_key":"107:3","arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},{"verse_key":"107:4","arabic":"فَوَيْلٌ لِّلْمُصَلِّينَ"},{"verse_key":"107:5","arabic":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"},{"verse_key":"107:6","arabic":"ٱلَّذِينَ هُمْ يُرَآءُونَ"},{"verse_key":"107:7","arabic":"وَيَمْنَعُونَ ٱلْمَاعُونَ"}]
