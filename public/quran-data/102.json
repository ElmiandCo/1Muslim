[{"verse_key":"102:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ"},{"verse_key":"102:2","arabic":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ"},{"verse_key":"102:3","arabic":"كَلَّا سَوْفَ تَعْلَمُونَ"},{"verse_key":"102:4","arabic":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"},{"verse_key":"102:5","arabic":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ"},{"verse_key":"102:6","arabic":"لَتَرَوُنَّ ٱلْجَحِيمَ"},{"verse_key":"102:7","arabic":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ"},{"verse_key":"102:8","arabic":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ"}]
