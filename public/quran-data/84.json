[{"verse_key":"84:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ"},{"verse_key":"84:2","arabic":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"verse_key":"84:3","arabic":"وَإِذَا ٱلْأَرْضُ مُدَّتْ"},{"verse_key":"84:4","arabic":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"verse_key":"84:5","arabic":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"verse_key":"84:6","arabic":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَٰقِيهِ"},{"verse_key":"84:7","arabic":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ"},{"verse_key":"84:8","arabic":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"},{"verse_key":"84:9","arabic":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا"},{"verse_key":"84:10","arabic":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"},{"verse_key":"84:11","arabic":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا"},{"verse_key":"84:12","arabic":"وَيَصْلَىٰ سَعِيرًا"},{"verse_key":"84:13","arabic":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا"},{"verse_key":"84:14","arabic":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"},{"verse_key":"84:15","arabic":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا"},{"verse_key":"84:16","arabic":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ"},{"verse_key":"84:17","arabic":"وَٱلَّيْلِ وَمَا وَسَقَ"},{"verse_key":"84:18","arabic":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ"},{"verse_key":"84:19","arabic":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ"},{"verse_key":"84:20","arabic":"فَمَا لَهُمْ لَا يُؤْمِنُونَ"},{"verse_key":"84:21","arabic":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ"},{"verse_key":"84:22","arabic":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ"},{"verse_key":"84:23","arabic":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ"},{"verse_key":"84:24","arabic":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ"},{"verse_key":"84:25","arabic":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ"}]
