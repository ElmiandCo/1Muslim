[{"verse_key":"93:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ"},{"verse_key":"93:2","arabic":"وَٱلَّيْلِ إِذَا سَجَىٰ"},{"verse_key":"93:3","arabic":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"verse_key":"93:4","arabic":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ"},{"verse_key":"93:5","arabic":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ"},{"verse_key":"93:6","arabic":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ"},{"verse_key":"93:7","arabic":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ"},{"verse_key":"93:8","arabic":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ"},{"verse_key":"93:9","arabic":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ"},{"verse_key":"93:10","arabic":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ"},{"verse_key":"93:11","arabic":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"}]
