[{"verse_key":"55:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلرَّحْمَٰنُ"},{"verse_key":"55:2","arabic":"عَلَّمَ ٱلْقُرْءَانَ"},{"verse_key":"55:3","arabic":"خَلَقَ ٱلْإِنسَٰنَ"},{"verse_key":"55:4","arabic":"عَلَّمَهُ ٱلْبَيَانَ"},{"verse_key":"55:5","arabic":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ"},{"verse_key":"55:6","arabic":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ"},{"verse_key":"55:7","arabic":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ"},{"verse_key":"55:8","arabic":"أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ"},{"verse_key":"55:9","arabic":"وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ"},{"verse_key":"55:10","arabic":"وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ"},{"verse_key":"55:11","arabic":"فِيهَا فَٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ"},{"verse_key":"55:12","arabic":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ"},{"verse_key":"55:13","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:14","arabic":"خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍ كَٱلْفَخَّارِ"},{"verse_key":"55:15","arabic":"وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ"},{"verse_key":"55:16","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:17","arabic":"رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ"},{"verse_key":"55:18","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:19","arabic":"مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ"},{"verse_key":"55:20","arabic":"بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ"},{"verse_key":"55:21","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:22","arabic":"يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ"},{"verse_key":"55:23","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:24","arabic":"وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ"},{"verse_key":"55:25","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:26","arabic":"كُلُّ مَنْ عَلَيْهَا فَانٍ"},{"verse_key":"55:27","arabic":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ"},{"verse_key":"55:28","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:29","arabic":"يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ"},{"verse_key":"55:30","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:31","arabic":"سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ"},{"verse_key":"55:32","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:33","arabic":"يَٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٍ"},{"verse_key":"55:34","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:35","arabic":"يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ"},{"verse_key":"55:36","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:37","arabic":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ"},{"verse_key":"55:38","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:39","arabic":"فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌ وَلَا جَآنٌّ"},{"verse_key":"55:40","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:41","arabic":"يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ"},{"verse_key":"55:42","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:43","arabic":"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ"},{"verse_key":"55:44","arabic":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍ"},{"verse_key":"55:45","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:46","arabic":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ"},{"verse_key":"55:47","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:48","arabic":"ذَوَاتَآ أَفْنَانٍ"},{"verse_key":"55:49","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:50","arabic":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ"},{"verse_key":"55:51","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:52","arabic":"فِيهِمَا مِن كُلِّ فَٰكِهَةٍ زَوْجَانِ"},{"verse_key":"55:53","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:54","arabic":"مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍ"},{"verse_key":"55:55","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:56","arabic":"فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ"},{"verse_key":"55:57","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:58","arabic":"كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ"},{"verse_key":"55:59","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:60","arabic":"هَلْ جَزَآءُ ٱلْإِحْسَٰنِ إِلَّا ٱلْإِحْسَٰنُ"},{"verse_key":"55:61","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:62","arabic":"وَمِن دُونِهِمَا جَنَّتَانِ"},{"verse_key":"55:63","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:64","arabic":"مُدْهَآمَّتَانِ"},{"verse_key":"55:65","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:66","arabic":"فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ"},{"verse_key":"55:67","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:68","arabic":"فِيهِمَا فَٰكِهَةٌ وَنَخْلٌ وَرُمَّانٌ"},{"verse_key":"55:69","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:70","arabic":"فِيهِنَّ خَيْرَٰتٌ حِسَانٌ"},{"verse_key":"55:71","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:72","arabic":"حُورٌ مَّقْصُورَٰتٌ فِى ٱلْخِيَامِ"},{"verse_key":"55:73","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:74","arabic":"لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ"},{"verse_key":"55:75","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:76","arabic":"مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍ وَعَبْقَرِىٍّ حِسَانٍ"},{"verse_key":"55:77","arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"verse_key":"55:78","arabic":"تَبَٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَٰلِ وَٱلْإِكْرَامِ"}]
