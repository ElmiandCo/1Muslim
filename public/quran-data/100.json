[{"verse_key":"100:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًا"},{"verse_key":"100:2","arabic":"فَٱلْمُورِيَٰتِ قَدْحًا"},{"verse_key":"100:3","arabic":"فَٱلْمُغِيرَٰتِ صُبْحًا"},{"verse_key":"100:4","arabic":"فَأَثَرْنَ بِهِۦ نَقْعًا"},{"verse_key":"100:5","arabic":"فَوَسَطْنَ بِهِۦ جَمْعًا"},{"verse_key":"100:6","arabic":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌ"},{"verse_key":"100:7","arabic":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ"},{"verse_key":"100:8","arabic":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ"},{"verse_key":"100:9","arabic":"أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ"},{"verse_key":"100:10","arabic":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ"},{"verse_key":"100:11","arabic":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ"}]
