[{"verse_key":"1:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"},{"verse_key":"1:2","arabic":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ"},{"verse_key":"1:3","arabic":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"},{"verse_key":"1:4","arabic":"مَٰلِكِ يَوْمِ ٱلدِّينِ"},{"verse_key":"1:5","arabic":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"},{"verse_key":"1:6","arabic":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"},{"verse_key":"1:7","arabic":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ"}]
