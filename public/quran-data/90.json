[{"verse_key":"90:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ"},{"verse_key":"90:2","arabic":"وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ"},{"verse_key":"90:3","arabic":"وَوَالِدٍ وَمَا وَلَدَ"},{"verse_key":"90:4","arabic":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ"},{"verse_key":"90:5","arabic":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ"},{"verse_key":"90:6","arabic":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا"},{"verse_key":"90:7","arabic":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ"},{"verse_key":"90:8","arabic":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"},{"verse_key":"90:9","arabic":"وَلِسَانًا وَشَفَتَيْنِ"},{"verse_key":"90:10","arabic":"وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ"},{"verse_key":"90:11","arabic":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ"},{"verse_key":"90:12","arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ"},{"verse_key":"90:13","arabic":"فَكُّ رَقَبَةٍ"},{"verse_key":"90:14","arabic":"أَوْ إِطْعَٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ"},{"verse_key":"90:15","arabic":"يَتِيمًا ذَا مَقْرَبَةٍ"},{"verse_key":"90:16","arabic":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ"},{"verse_key":"90:17","arabic":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ"},{"verse_key":"90:18","arabic":"أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ"},{"verse_key":"90:19","arabic":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ"},{"verse_key":"90:20","arabic":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ"}]
