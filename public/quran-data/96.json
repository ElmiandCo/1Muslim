[{"verse_key":"96:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ"},{"verse_key":"96:2","arabic":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ"},{"verse_key":"96:3","arabic":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ"},{"verse_key":"96:4","arabic":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ"},{"verse_key":"96:5","arabic":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ"},{"verse_key":"96:6","arabic":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ"},{"verse_key":"96:7","arabic":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ"},{"verse_key":"96:8","arabic":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ"},{"verse_key":"96:9","arabic":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ"},{"verse_key":"96:10","arabic":"عَبْدًا إِذَا صَلَّىٰٓ"},{"verse_key":"96:11","arabic":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ"},{"verse_key":"96:12","arabic":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ"},{"verse_key":"96:13","arabic":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"},{"verse_key":"96:14","arabic":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ"},{"verse_key":"96:15","arabic":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ"},{"verse_key":"96:16","arabic":"نَاصِيَةٍ كَٰذِبَةٍ خَاطِئَةٍ"},{"verse_key":"96:17","arabic":"فَلْيَدْعُ نَادِيَهُۥ"},{"verse_key":"96:18","arabic":"سَنَدْعُ ٱلزَّبَانِيَةَ"},{"verse_key":"96:19","arabic":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب"}]
