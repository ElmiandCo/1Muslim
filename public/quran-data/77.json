[{"verse_key":"77:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًا"},{"verse_key":"77:2","arabic":"فَٱلْعَٰصِفَٰتِ عَصْفًا"},{"verse_key":"77:3","arabic":"وَٱلنَّٰشِرَٰتِ نَشْرًا"},{"verse_key":"77:4","arabic":"فَٱلْفَٰرِقَٰتِ فَرْقًا"},{"verse_key":"77:5","arabic":"فَٱلْمُلْقِيَٰتِ ذِكْرًا"},{"verse_key":"77:6","arabic":"عُذْرًا أَوْ نُذْرًا"},{"verse_key":"77:7","arabic":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ"},{"verse_key":"77:8","arabic":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ"},{"verse_key":"77:9","arabic":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ"},{"verse_key":"77:10","arabic":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ"},{"verse_key":"77:11","arabic":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ"},{"verse_key":"77:12","arabic":"لِأَىِّ يَوْمٍ أُجِّلَتْ"},{"verse_key":"77:13","arabic":"لِيَوْمِ ٱلْفَصْلِ"},{"verse_key":"77:14","arabic":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ"},{"verse_key":"77:15","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"verse_key":"77:16","arabic":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ"},{"verse_key":"77:17","arabic":"ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ"},{"verse_key":"77:18","arabic":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"},{"verse_key":"77:19","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"verse_key":"77:20","arabic":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ"},{"verse_key":"77:21","arabic":"فَجَعَلْنَٰهُ فِى قَرَارٍ مَّكِينٍ"},{"verse_key":"77:22","arabic":"إِلَىٰ قَدَرٍ مَّعْلُومٍ"},{"verse_key":"77:23","arabic":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ"},{"verse_key":"77:24","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"verse_key":"77:25","arabic":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا"},{"verse_key":"77:26","arabic":"أَحْيَآءً وَأَمْوَٰتًا"},{"verse_key":"77:27","arabic":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍ وَأَسْقَيْنَٰكُم مَّآءً فُرَاتًا"},{"verse_key":"77:28","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"verse_key":"77:29","arabic":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"},{"verse_key":"77:30","arabic":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَٰثِ شُعَبٍ"},{"verse_key":"77:31","arabic":"لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ"},{"verse_key":"77:32","arabic":"إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ"},{"verse_key":"77:33","arabic":"كَأَنَّهُۥ جِمَٰلَتٌ صُفْرٌ"},{"verse_key":"77:34","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"verse_key":"77:35","arabic":"هَٰذَا يَوْمُ لَا يَنطِقُونَ"},{"verse_key":"77:36","arabic":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"},{"verse_key":"77:37","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"verse_key":"77:38","arabic":"هَٰذَا يَوْمُ ٱلْفَصْلِ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ"},{"verse_key":"77:39","arabic":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ"},{"verse_key":"77:40","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"verse_key":"77:41","arabic":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍ وَعُيُونٍ"},{"verse_key":"77:42","arabic":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ"},{"verse_key":"77:43","arabic":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ"},{"verse_key":"77:44","arabic":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"verse_key":"77:45","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"verse_key":"77:46","arabic":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ"},{"verse_key":"77:47","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"verse_key":"77:48","arabic":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ"},{"verse_key":"77:49","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"verse_key":"77:50","arabic":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ"}]
