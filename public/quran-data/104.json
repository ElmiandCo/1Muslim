[{"verse_key":"104:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ"},{"verse_key":"104:2","arabic":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ"},{"verse_key":"104:3","arabic":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"},{"verse_key":"104:4","arabic":"كَلَّا لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ"},{"verse_key":"104:5","arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ"},{"verse_key":"104:6","arabic":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ"},{"verse_key":"104:7","arabic":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ"},{"verse_key":"104:8","arabic":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ"},{"verse_key":"104:9","arabic":"فِى عَمَدٍ مُّمَدَّدَةٍۭ"}]
