[{"verse_key":"91:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا"},{"verse_key":"91:2","arabic":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا"},{"verse_key":"91:3","arabic":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"},{"verse_key":"91:4","arabic":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا"},{"verse_key":"91:5","arabic":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"},{"verse_key":"91:6","arabic":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا"},{"verse_key":"91:7","arabic":"وَنَفْسٍ وَمَا سَوَّىٰهَا"},{"verse_key":"91:8","arabic":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا"},{"verse_key":"91:9","arabic":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا"},{"verse_key":"91:10","arabic":"وَقَدْ خَابَ مَن دَسَّىٰهَا"},{"verse_key":"91:11","arabic":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ"},{"verse_key":"91:12","arabic":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا"},{"verse_key":"91:13","arabic":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا"},{"verse_key":"91:14","arabic":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا"},{"verse_key":"91:15","arabic":"وَلَا يَخَافُ عُقْبَٰهَا"}]
