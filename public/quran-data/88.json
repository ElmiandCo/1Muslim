[{"verse_key":"88:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ"},{"verse_key":"88:2","arabic":"وُجُوهٌ يَوْمَئِذٍ خَٰشِعَةٌ"},{"verse_key":"88:3","arabic":"عَامِلَةٌ نَّاصِبَةٌ"},{"verse_key":"88:4","arabic":"تَصْلَىٰ نَارًا حَامِيَةً"},{"verse_key":"88:5","arabic":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"},{"verse_key":"88:6","arabic":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ"},{"verse_key":"88:7","arabic":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ"},{"verse_key":"88:8","arabic":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ"},{"verse_key":"88:9","arabic":"لِّسَعْيِهَا رَاضِيَةٌ"},{"verse_key":"88:10","arabic":"فِى جَنَّةٍ عَالِيَةٍ"},{"verse_key":"88:11","arabic":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةً"},{"verse_key":"88:12","arabic":"فِيهَا عَيْنٌ جَارِيَةٌ"},{"verse_key":"88:13","arabic":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ"},{"verse_key":"88:14","arabic":"وَأَكْوَابٌ مَّوْضُوعَةٌ"},{"verse_key":"88:15","arabic":"وَنَمَارِقُ مَصْفُوفَةٌ"},{"verse_key":"88:16","arabic":"وَزَرَابِىُّ مَبْثُوثَةٌ"},{"verse_key":"88:17","arabic":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ"},{"verse_key":"88:18","arabic":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ"},{"verse_key":"88:19","arabic":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ"},{"verse_key":"88:20","arabic":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ"},{"verse_key":"88:21","arabic":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ"},{"verse_key":"88:22","arabic":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ"},{"verse_key":"88:23","arabic":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"},{"verse_key":"88:24","arabic":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ"},{"verse_key":"88:25","arabic":"إِنَّ إِلَيْنَآ إِيَابَهُمْ"},{"verse_key":"88:26","arabic":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم"}]
