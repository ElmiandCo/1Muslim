[{"verse_key":"101:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ"},{"verse_key":"101:2","arabic":"مَا ٱلْقَارِعَةُ"},{"verse_key":"101:3","arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ"},{"verse_key":"101:4","arabic":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ"},{"verse_key":"101:5","arabic":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ"},{"verse_key":"101:6","arabic":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ"},{"verse_key":"101:7","arabic":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ"},{"verse_key":"101:8","arabic":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ"},{"verse_key":"101:9","arabic":"فَأُمُّهُۥ هَاوِيَةٌ"},{"verse_key":"101:10","arabic":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ"},{"verse_key":"101:11","arabic":"نَارٌ حَامِيَةٌۢ"}]
