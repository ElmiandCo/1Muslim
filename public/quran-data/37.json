[{"verse_key":"37:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلصَّٰٓفَّٰتِ صَفًّا"},{"verse_key":"37:2","arabic":"فَٱلزَّٰجِرَٰتِ زَجْرًا"},{"verse_key":"37:3","arabic":"فَٱلتَّٰلِيَٰتِ ذِكْرًا"},{"verse_key":"37:4","arabic":"إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌ"},{"verse_key":"37:5","arabic":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ"},{"verse_key":"37:6","arabic":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ"},{"verse_key":"37:7","arabic":"وَحِفْظًا مِّن كُلِّ شَيْطَٰنٍ مَّارِدٍ"},{"verse_key":"37:8","arabic":"لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ"},{"verse_key":"37:9","arabic":"دُحُورًا وَلَهُمْ عَذَابٌ وَاصِبٌ"},{"verse_key":"37:10","arabic":"إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ"},{"verse_key":"37:11","arabic":"فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ إِنَّا خَلَقْنَٰهُم مِّن طِينٍ لَّازِبٍۭ"},{"verse_key":"37:12","arabic":"بَلْ عَجِبْتَ وَيَسْخَرُونَ"},{"verse_key":"37:13","arabic":"وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ"},{"verse_key":"37:14","arabic":"وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ"},{"verse_key":"37:15","arabic":"وَقَالُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌ مُّبِينٌ"},{"verse_key":"37:16","arabic":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ"},{"verse_key":"37:17","arabic":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ"},{"verse_key":"37:18","arabic":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ"},{"verse_key":"37:19","arabic":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ"},{"verse_key":"37:20","arabic":"وَقَالُوا۟ يَٰوَيْلَنَا هَٰذَا يَوْمُ ٱلدِّينِ"},{"verse_key":"37:21","arabic":"هَٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ"},{"verse_key":"37:22","arabic":"ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ"},{"verse_key":"37:23","arabic":"مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ"},{"verse_key":"37:24","arabic":"وَقِفُوهُمْ إِنَّهُم مَّسْـُٔولُونَ"},{"verse_key":"37:25","arabic":"مَا لَكُمْ لَا تَنَاصَرُونَ"},{"verse_key":"37:26","arabic":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ"},{"verse_key":"37:27","arabic":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"},{"verse_key":"37:28","arabic":"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ"},{"verse_key":"37:29","arabic":"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ"},{"verse_key":"37:30","arabic":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنٍۭ بَلْ كُنتُمْ قَوْمًا طَٰغِينَ"},{"verse_key":"37:31","arabic":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ إِنَّا لَذَآئِقُونَ"},{"verse_key":"37:32","arabic":"فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَ"},{"verse_key":"37:33","arabic":"فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ"},{"verse_key":"37:34","arabic":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"},{"verse_key":"37:35","arabic":"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ"},{"verse_key":"37:36","arabic":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ"},{"verse_key":"37:37","arabic":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ"},{"verse_key":"37:38","arabic":"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ"},{"verse_key":"37:39","arabic":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"},{"verse_key":"37:40","arabic":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"verse_key":"37:41","arabic":"أُو۟لَٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ"},{"verse_key":"37:42","arabic":"فَوَٰكِهُ وَهُم مُّكْرَمُونَ"},{"verse_key":"37:43","arabic":"فِى جَنَّٰتِ ٱلنَّعِيمِ"},{"verse_key":"37:44","arabic":"عَلَىٰ سُرُرٍ مُّتَقَٰبِلِينَ"},{"verse_key":"37:45","arabic":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ"},{"verse_key":"37:46","arabic":"بَيْضَآءَ لَذَّةٍ لِّلشَّٰرِبِينَ"},{"verse_key":"37:47","arabic":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ"},{"verse_key":"37:48","arabic":"وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ عِينٌ"},{"verse_key":"37:49","arabic":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ"},{"verse_key":"37:50","arabic":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"},{"verse_key":"37:51","arabic":"قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ"},{"verse_key":"37:52","arabic":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ"},{"verse_key":"37:53","arabic":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ"},{"verse_key":"37:54","arabic":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ"},{"verse_key":"37:55","arabic":"فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ"},{"verse_key":"37:56","arabic":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ"},{"verse_key":"37:57","arabic":"وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ"},{"verse_key":"37:58","arabic":"أَفَمَا نَحْنُ بِمَيِّتِينَ"},{"verse_key":"37:59","arabic":"إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ"},{"verse_key":"37:60","arabic":"إِنَّ هَٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ"},{"verse_key":"37:61","arabic":"لِمِثْلِ هَٰذَا فَلْيَعْمَلِ ٱلْعَٰمِلُونَ"},{"verse_key":"37:62","arabic":"أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ"},{"verse_key":"37:63","arabic":"إِنَّا جَعَلْنَٰهَا فِتْنَةً لِّلظَّٰلِمِينَ"},{"verse_key":"37:64","arabic":"إِنَّهَا شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ"},{"verse_key":"37:65","arabic":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ"},{"verse_key":"37:66","arabic":"فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"},{"verse_key":"37:67","arabic":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ"},{"verse_key":"37:68","arabic":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ"},{"verse_key":"37:69","arabic":"إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ"},{"verse_key":"37:70","arabic":"فَهُمْ عَلَىٰٓ ءَاثَٰرِهِمْ يُهْرَعُونَ"},{"verse_key":"37:71","arabic":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ"},{"verse_key":"37:72","arabic":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ"},{"verse_key":"37:73","arabic":"فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُنذَرِينَ"},{"verse_key":"37:74","arabic":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"verse_key":"37:75","arabic":"وَلَقَدْ نَادَىٰنَا نُوحٌ فَلَنِعْمَ ٱلْمُجِيبُونَ"},{"verse_key":"37:76","arabic":"وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"},{"verse_key":"37:77","arabic":"وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ"},{"verse_key":"37:78","arabic":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"},{"verse_key":"37:79","arabic":"سَلَٰمٌ عَلَىٰ نُوحٍ فِى ٱلْعَٰلَمِينَ"},{"verse_key":"37:80","arabic":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"verse_key":"37:81","arabic":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"},{"verse_key":"37:82","arabic":"ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ"},{"verse_key":"37:83","arabic":"وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ"},{"verse_key":"37:84","arabic":"إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍ سَلِيمٍ"},{"verse_key":"37:85","arabic":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ"},{"verse_key":"37:86","arabic":"أَئِفْكًا ءَالِهَةً دُونَ ٱللَّهِ تُرِيدُونَ"},{"verse_key":"37:87","arabic":"فَمَا ظَنُّكُم بِرَبِّ ٱلْعَٰلَمِينَ"},{"verse_key":"37:88","arabic":"فَنَظَرَ نَظْرَةً فِى ٱلنُّجُومِ"},{"verse_key":"37:89","arabic":"فَقَالَ إِنِّى سَقِيمٌ"},{"verse_key":"37:90","arabic":"فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ"},{"verse_key":"37:91","arabic":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ"},{"verse_key":"37:92","arabic":"مَا لَكُمْ لَا تَنطِقُونَ"},{"verse_key":"37:93","arabic":"فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ"},{"verse_key":"37:94","arabic":"فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ"},{"verse_key":"37:95","arabic":"قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ"},{"verse_key":"37:96","arabic":"وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ"},{"verse_key":"37:97","arabic":"قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَٰنًا فَأَلْقُوهُ فِى ٱلْجَحِيمِ"},{"verse_key":"37:98","arabic":"فَأَرَادُوا۟ بِهِۦ كَيْدًا فَجَعَلْنَٰهُمُ ٱلْأَسْفَلِينَ"},{"verse_key":"37:99","arabic":"وَقَالَ إِنِّى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْدِينِ"},{"verse_key":"37:100","arabic":"رَبِّ هَبْ لِى مِنَ ٱلصَّٰلِحِينَ"},{"verse_key":"37:101","arabic":"فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٍ"},{"verse_key":"37:102","arabic":"فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعْىَ قَالَ يَٰبُنَىَّ إِنِّىٓ أَرَىٰ فِى ٱلْمَنَامِ أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ مَاذَا تَرَىٰ قَالَ يَٰٓأَبَتِ ٱفْعَلْ مَا تُؤْمَرُ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ"},{"verse_key":"37:103","arabic":"فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ"},{"verse_key":"37:104","arabic":"وَنَٰدَيْنَٰهُ أَن يَٰٓإِبْرَٰهِيمُ"},{"verse_key":"37:105","arabic":"قَدْ صَدَّقْتَ ٱلرُّءْيَآ إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"verse_key":"37:106","arabic":"إِنَّ هَٰذَا لَهُوَ ٱلْبَلَٰٓؤُا۟ ٱلْمُبِينُ"},{"verse_key":"37:107","arabic":"وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٍ"},{"verse_key":"37:108","arabic":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"},{"verse_key":"37:109","arabic":"سَلَٰمٌ عَلَىٰٓ إِبْرَٰهِيمَ"},{"verse_key":"37:110","arabic":"كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"verse_key":"37:111","arabic":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"},{"verse_key":"37:112","arabic":"وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيًّا مِّنَ ٱلصَّٰلِحِينَ"},{"verse_key":"37:113","arabic":"وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَٰقَ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِّنَفْسِهِۦ مُبِينٌ"},{"verse_key":"37:114","arabic":"وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ"},{"verse_key":"37:115","arabic":"وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"},{"verse_key":"37:116","arabic":"وَنَصَرْنَٰهُمْ فَكَانُوا۟ هُمُ ٱلْغَٰلِبِينَ"},{"verse_key":"37:117","arabic":"وَءَاتَيْنَٰهُمَا ٱلْكِتَٰبَ ٱلْمُسْتَبِينَ"},{"verse_key":"37:118","arabic":"وَهَدَيْنَٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"},{"verse_key":"37:119","arabic":"وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْـَٔاخِرِينَ"},{"verse_key":"37:120","arabic":"سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ"},{"verse_key":"37:121","arabic":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"verse_key":"37:122","arabic":"إِنَّهُمَا مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"},{"verse_key":"37:123","arabic":"وَإِنَّ إِلْيَاسَ لَمِنَ ٱلْمُرْسَلِينَ"},{"verse_key":"37:124","arabic":"إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ"},{"verse_key":"37:125","arabic":"أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ ٱلْخَٰلِقِينَ"},{"verse_key":"37:126","arabic":"ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ"},{"verse_key":"37:127","arabic":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ"},{"verse_key":"37:128","arabic":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"verse_key":"37:129","arabic":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"},{"verse_key":"37:130","arabic":"سَلَٰمٌ عَلَىٰٓ إِلْ يَاسِينَ"},{"verse_key":"37:131","arabic":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"verse_key":"37:132","arabic":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"},{"verse_key":"37:133","arabic":"وَإِنَّ لُوطًا لَّمِنَ ٱلْمُرْسَلِينَ"},{"verse_key":"37:134","arabic":"إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ"},{"verse_key":"37:135","arabic":"إِلَّا عَجُوزًا فِى ٱلْغَٰبِرِينَ"},{"verse_key":"37:136","arabic":"ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ"},{"verse_key":"37:137","arabic":"وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ"},{"verse_key":"37:138","arabic":"وَبِٱلَّيْلِ أَفَلَا تَعْقِلُونَ"},{"verse_key":"37:139","arabic":"وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ"},{"verse_key":"37:140","arabic":"إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ"},{"verse_key":"37:141","arabic":"فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ"},{"verse_key":"37:142","arabic":"فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌ"},{"verse_key":"37:143","arabic":"فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ"},{"verse_key":"37:144","arabic":"لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ"},{"verse_key":"37:145","arabic":"فَنَبَذْنَٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌ"},{"verse_key":"37:146","arabic":"وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ"},{"verse_key":"37:147","arabic":"وَأَرْسَلْنَٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ"},{"verse_key":"37:148","arabic":"فَـَٔامَنُوا۟ فَمَتَّعْنَٰهُمْ إِلَىٰ حِينٍ"},{"verse_key":"37:149","arabic":"فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ"},{"verse_key":"37:150","arabic":"أَمْ خَلَقْنَا ٱلْمَلَٰٓئِكَةَ إِنَٰثًا وَهُمْ شَٰهِدُونَ"},{"verse_key":"37:151","arabic":"أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ"},{"verse_key":"37:152","arabic":"وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَٰذِبُونَ"},{"verse_key":"37:153","arabic":"أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ"},{"verse_key":"37:154","arabic":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ"},{"verse_key":"37:155","arabic":"أَفَلَا تَذَكَّرُونَ"},{"verse_key":"37:156","arabic":"أَمْ لَكُمْ سُلْطَٰنٌ مُّبِينٌ"},{"verse_key":"37:157","arabic":"فَأْتُوا۟ بِكِتَٰبِكُمْ إِن كُنتُمْ صَٰدِقِينَ"},{"verse_key":"37:158","arabic":"وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًا وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ"},{"verse_key":"37:159","arabic":"سُبْحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ"},{"verse_key":"37:160","arabic":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"verse_key":"37:161","arabic":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ"},{"verse_key":"37:162","arabic":"مَآ أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ"},{"verse_key":"37:163","arabic":"إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ"},{"verse_key":"37:164","arabic":"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌ مَّعْلُومٌ"},{"verse_key":"37:165","arabic":"وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ"},{"verse_key":"37:166","arabic":"وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ"},{"verse_key":"37:167","arabic":"وَإِن كَانُوا۟ لَيَقُولُونَ"},{"verse_key":"37:168","arabic":"لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ ٱلْأَوَّلِينَ"},{"verse_key":"37:169","arabic":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"verse_key":"37:170","arabic":"فَكَفَرُوا۟ بِهِۦ فَسَوْفَ يَعْلَمُونَ"},{"verse_key":"37:171","arabic":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ"},{"verse_key":"37:172","arabic":"إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ"},{"verse_key":"37:173","arabic":"وَإِنَّ جُندَنَا لَهُمُ ٱلْغَٰلِبُونَ"},{"verse_key":"37:174","arabic":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"verse_key":"37:175","arabic":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"},{"verse_key":"37:176","arabic":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"},{"verse_key":"37:177","arabic":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ"},{"verse_key":"37:178","arabic":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"verse_key":"37:179","arabic":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"},{"verse_key":"37:180","arabic":"سُبْحَٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ"},{"verse_key":"37:181","arabic":"وَسَلَٰمٌ عَلَى ٱلْمُرْسَلِينَ"},{"verse_key":"37:182","arabic":"وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ"}]
