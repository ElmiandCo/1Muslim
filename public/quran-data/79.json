[{"verse_key":"79:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًا"},{"verse_key":"79:2","arabic":"وَٱلنَّٰشِطَٰتِ نَشْطًا"},{"verse_key":"79:3","arabic":"وَٱلسَّٰبِحَٰتِ سَبْحًا"},{"verse_key":"79:4","arabic":"فَٱلسَّٰبِقَٰتِ سَبْقًا"},{"verse_key":"79:5","arabic":"فَٱلْمُدَبِّرَٰتِ أَمْرًا"},{"verse_key":"79:6","arabic":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ"},{"verse_key":"79:7","arabic":"تَتْبَعُهَا ٱلرَّادِفَةُ"},{"verse_key":"79:8","arabic":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ"},{"verse_key":"79:9","arabic":"أَبْصَٰرُهَا خَٰشِعَةٌ"},{"verse_key":"79:10","arabic":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ"},{"verse_key":"79:11","arabic":"أَءِذَا كُنَّا عِظَٰمًا نَّخِرَةً"},{"verse_key":"79:12","arabic":"قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ"},{"verse_key":"79:13","arabic":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ"},{"verse_key":"79:14","arabic":"فَإِذَا هُم بِٱلسَّاهِرَةِ"},{"verse_key":"79:15","arabic":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"},{"verse_key":"79:16","arabic":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى"},{"verse_key":"79:17","arabic":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ"},{"verse_key":"79:18","arabic":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ"},{"verse_key":"79:19","arabic":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ"},{"verse_key":"79:20","arabic":"فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ"},{"verse_key":"79:21","arabic":"فَكَذَّبَ وَعَصَىٰ"},{"verse_key":"79:22","arabic":"ثُمَّ أَدْبَرَ يَسْعَىٰ"},{"verse_key":"79:23","arabic":"فَحَشَرَ فَنَادَىٰ"},{"verse_key":"79:24","arabic":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ"},{"verse_key":"79:25","arabic":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ"},{"verse_key":"79:26","arabic":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ"},{"verse_key":"79:27","arabic":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ بَنَىٰهَا"},{"verse_key":"79:28","arabic":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا"},{"verse_key":"79:29","arabic":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا"},{"verse_key":"79:30","arabic":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ"},{"verse_key":"79:31","arabic":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا"},{"verse_key":"79:32","arabic":"وَٱلْجِبَالَ أَرْسَىٰهَا"},{"verse_key":"79:33","arabic":"مَتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ"},{"verse_key":"79:34","arabic":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ"},{"verse_key":"79:35","arabic":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ"},{"verse_key":"79:36","arabic":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ"},{"verse_key":"79:37","arabic":"فَأَمَّا مَن طَغَىٰ"},{"verse_key":"79:38","arabic":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"},{"verse_key":"79:39","arabic":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ"},{"verse_key":"79:40","arabic":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ"},{"verse_key":"79:41","arabic":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ"},{"verse_key":"79:42","arabic":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا"},{"verse_key":"79:43","arabic":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ"},{"verse_key":"79:44","arabic":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ"},{"verse_key":"79:45","arabic":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا"},{"verse_key":"79:46","arabic":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا"}]
