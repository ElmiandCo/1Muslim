[{"verse_key":"89:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ"},{"verse_key":"89:2","arabic":"وَلَيَالٍ عَشْرٍ"},{"verse_key":"89:3","arabic":"وَٱلشَّفْعِ وَٱلْوَتْرِ"},{"verse_key":"89:4","arabic":"وَٱلَّيْلِ إِذَا يَسْرِ"},{"verse_key":"89:5","arabic":"هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ"},{"verse_key":"89:6","arabic":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"verse_key":"89:7","arabic":"إِرَمَ ذَاتِ ٱلْعِمَادِ"},{"verse_key":"89:8","arabic":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ"},{"verse_key":"89:9","arabic":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ"},{"verse_key":"89:10","arabic":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ"},{"verse_key":"89:11","arabic":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ"},{"verse_key":"89:12","arabic":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ"},{"verse_key":"89:13","arabic":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ"},{"verse_key":"89:14","arabic":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ"},{"verse_key":"89:15","arabic":"فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ"},{"verse_key":"89:16","arabic":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ"},{"verse_key":"89:17","arabic":"كَلَّا بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ"},{"verse_key":"89:18","arabic":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},{"verse_key":"89:19","arabic":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا"},{"verse_key":"89:20","arabic":"وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا"},{"verse_key":"89:21","arabic":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا"},{"verse_key":"89:22","arabic":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا"},{"verse_key":"89:23","arabic":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ"},{"verse_key":"89:24","arabic":"يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"},{"verse_key":"89:25","arabic":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ"},{"verse_key":"89:26","arabic":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ"},{"verse_key":"89:27","arabic":"يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"},{"verse_key":"89:28","arabic":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً"},{"verse_key":"89:29","arabic":"فَٱدْخُلِى فِى عِبَٰدِى"},{"verse_key":"89:30","arabic":"وَٱدْخُلِى جَنَّتِى"}]
