[{"verse_key":"94:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ"},{"verse_key":"94:2","arabic":"وَوَضَعْنَا عَنكَ وِزْرَكَ"},{"verse_key":"94:3","arabic":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ"},{"verse_key":"94:4","arabic":"وَرَفَعْنَا لَكَ ذِكْرَكَ"},{"verse_key":"94:5","arabic":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"},{"verse_key":"94:6","arabic":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"},{"verse_key":"94:7","arabic":"فَإِذَا فَرَغْتَ فَٱنصَبْ"},{"verse_key":"94:8","arabic":"وَإِلَىٰ رَبِّكَ فَٱرْغَب"}]
