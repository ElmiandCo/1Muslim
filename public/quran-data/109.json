[{"verse_key":"109:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ"},{"verse_key":"109:2","arabic":"لَآ أَعْبُدُ مَا تَعْبُدُونَ"},{"verse_key":"109:3","arabic":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ"},{"verse_key":"109:4","arabic":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ"},{"verse_key":"109:5","arabic":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ"},{"verse_key":"109:6","arabic":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ"}]
