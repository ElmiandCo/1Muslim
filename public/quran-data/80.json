[{"verse_key":"80:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ"},{"verse_key":"80:2","arabic":"أَن جَآءَهُ ٱلْأَعْمَىٰ"},{"verse_key":"80:3","arabic":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"},{"verse_key":"80:4","arabic":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ"},{"verse_key":"80:5","arabic":"أَمَّا مَنِ ٱسْتَغْنَىٰ"},{"verse_key":"80:6","arabic":"فَأَنتَ لَهُۥ تَصَدَّىٰ"},{"verse_key":"80:7","arabic":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"},{"verse_key":"80:8","arabic":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ"},{"verse_key":"80:9","arabic":"وَهُوَ يَخْشَىٰ"},{"verse_key":"80:10","arabic":"فَأَنتَ عَنْهُ تَلَهَّىٰ"},{"verse_key":"80:11","arabic":"كَلَّآ إِنَّهَا تَذْكِرَةٌ"},{"verse_key":"80:12","arabic":"فَمَن شَآءَ ذَكَرَهُۥ"},{"verse_key":"80:13","arabic":"فِى صُحُفٍ مُّكَرَّمَةٍ"},{"verse_key":"80:14","arabic":"مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ"},{"verse_key":"80:15","arabic":"بِأَيْدِى سَفَرَةٍ"},{"verse_key":"80:16","arabic":"كِرَامٍۭ بَرَرَةٍ"},{"verse_key":"80:17","arabic":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ"},{"verse_key":"80:18","arabic":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"},{"verse_key":"80:19","arabic":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"},{"verse_key":"80:20","arabic":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"},{"verse_key":"80:21","arabic":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ"},{"verse_key":"80:22","arabic":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"},{"verse_key":"80:23","arabic":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ"},{"verse_key":"80:24","arabic":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ"},{"verse_key":"80:25","arabic":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا"},{"verse_key":"80:26","arabic":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا"},{"verse_key":"80:27","arabic":"فَأَنۢبَتْنَا فِيهَا حَبًّا"},{"verse_key":"80:28","arabic":"وَعِنَبًا وَقَضْبًا"},{"verse_key":"80:29","arabic":"وَزَيْتُونًا وَنَخْلًا"},{"verse_key":"80:30","arabic":"وَحَدَآئِقَ غُلْبًا"},{"verse_key":"80:31","arabic":"وَفَٰكِهَةً وَأَبًّا"},{"verse_key":"80:32","arabic":"مَّتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ"},{"verse_key":"80:33","arabic":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"},{"verse_key":"80:34","arabic":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ"},{"verse_key":"80:35","arabic":"وَأُمِّهِۦ وَأَبِيهِ"},{"verse_key":"80:36","arabic":"وَصَٰحِبَتِهِۦ وَبَنِيهِ"},{"verse_key":"80:37","arabic":"لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ"},{"verse_key":"80:38","arabic":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ"},{"verse_key":"80:39","arabic":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ"},{"verse_key":"80:40","arabic":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"},{"verse_key":"80:41","arabic":"تَرْهَقُهَا قَتَرَةٌ"},{"verse_key":"80:42","arabic":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ"}]
