[{"verse_key":"105:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ"},{"verse_key":"105:2","arabic":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ"},{"verse_key":"105:3","arabic":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"},{"verse_key":"105:4","arabic":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ"},{"verse_key":"105:5","arabic":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ"}]
