[{"verse_key":"92:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ"},{"verse_key":"92:2","arabic":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"},{"verse_key":"92:3","arabic":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"},{"verse_key":"92:4","arabic":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ"},{"verse_key":"92:5","arabic":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ"},{"verse_key":"92:6","arabic":"وَصَدَّقَ بِٱلْحُسْنَىٰ"},{"verse_key":"92:7","arabic":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ"},{"verse_key":"92:8","arabic":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ"},{"verse_key":"92:9","arabic":"وَكَذَّبَ بِٱلْحُسْنَىٰ"},{"verse_key":"92:10","arabic":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ"},{"verse_key":"92:11","arabic":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"},{"verse_key":"92:12","arabic":"إِنَّ عَلَيْنَا لَلْهُدَىٰ"},{"verse_key":"92:13","arabic":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ"},{"verse_key":"92:14","arabic":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ"},{"verse_key":"92:15","arabic":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى"},{"verse_key":"92:16","arabic":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"},{"verse_key":"92:17","arabic":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى"},{"verse_key":"92:18","arabic":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ"},{"verse_key":"92:19","arabic":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ"},{"verse_key":"92:20","arabic":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ"},{"verse_key":"92:21","arabic":"وَلَسَوْفَ يَرْضَىٰ"}]
