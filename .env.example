# OneMuslim / Supabase public runtime configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LiveKit WebRTC media backend (server-only)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Server-side 1Muslim worldwide search (Brave Search API)
# Required for real web / news / video results. NEVER prefix with NEXT_PUBLIC_ .
BRAVE_SEARCH_API_KEY=

# Optional: only for on-demand web AI overview; shared HudHud key can be used.
OPENAI_API_KEY=
SEARCH_SUMMARY_MODEL=gpt-4o-mini
