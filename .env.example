# OneMuslim / Supabase public runtime configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LiveKit WebRTC media backend (server-only)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Server-only Brave Search key. Required for all global search categories.
# Set it for preview testing; add to production only after spend limits + launch QA.
BRAVE_SEARCH_API_KEY=
# Optional model for on-demand citation-backed AI overviews.
SEARCH_SUMMARY_MODEL=gpt-4o-mini
